{
  "name": "fpv-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebGPU FPV quadcopter simulator: physically based flight model, ray-traced GI, procedural eroded terrain, real-star night sky.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stars": "python3 tools/build_stars.py $HYG_CSV public/data/stars.bin 8.0",
    "shot": "node tools/shot.mjs",
    "bench": "node tools/bench.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
