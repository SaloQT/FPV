{
  // Static-site Worker for the built simulator. Deploy with `npx wrangler deploy --temporary` for an
  // ephemeral preview account (no login; the account and its URL expire), or set CLOUDFLARE_API_TOKEN and
  // drop --temporary for a permanent one.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fpv-sim-ultra",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
